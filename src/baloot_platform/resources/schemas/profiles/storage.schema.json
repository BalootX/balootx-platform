{
  "$id": "https://baloot.local/schemas/profiles/storage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "additionalProperties": false,
      "properties": {
        "plugin": {
          "type": "string"
        },
        "root": {
          "type": "string"
        }
      },
      "required": [
        "plugin",
        "root"
      ],
      "type": "object"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "plugin": {
          "type": "string"
        }
      },
      "required": [
        "plugin"
      ],
      "type": "object"
    },
    "profile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "version"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "artifacts",
    "metadata",
    "profile",
    "schema_version"
  ],
  "type": "object"
}
