{
  "name": "@balootx/foundry-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/check-generated-api.mjs && tsc --noEmit && vite build",
    "check": "node scripts/check-generated-api.mjs && tsc --noEmit",
    "check:api-generated": "node scripts/check-generated-api.mjs",
    "generate:api": "openapi-ts --file openapi-ts.config.mjs --no-log-file",
    "test:research": "vitest --root ../../../.. run tests/frontend/research_recipes.spec.ts tests/frontend/card_selector.spec.tsx tests/frontend/ortools_scenario_ui.spec.ts tests/frontend/ortools_scenario_predicate_capabilities.spec.ts tests/frontend/video_playback_state.spec.ts tests/frontend/video_qr_policy.spec.ts",
    "test:operator-e2e": "playwright test --config e2e/playwright.config.cjs"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18"
  },
  "dependencies": {
    "@tanstack/react-table": "9.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@babel/parser": "8.1.2",
    "@hey-api/openapi-ts": "0.99.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
