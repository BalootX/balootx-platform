{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["publicRemote", "maxReceiptAgeSeconds", "rendererPaths"],
  "properties": {
    "publicRemote": {
      "type": "string",
      "pattern": "^(?:https|file)://[^\\s]+$"
    },
    "maxReceiptAgeSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "rendererPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
      }
    }
  }
}
