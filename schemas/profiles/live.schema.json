{
  "$id": "https://baloot.local/schemas/profiles/live.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "anti_cheat": {
      "additionalProperties": false,
      "properties": {
        "action_hash_chain": {
          "type": "boolean"
        },
        "assistance_policy_default": {
          "type": "string"
        },
        "preserve_all_attempts": {
          "type": "boolean"
        },
        "reject_out_of_turn": {
          "type": "boolean"
        },
        "reject_wrong_seat": {
          "type": "boolean"
        }
      },
      "required": [
        "action_hash_chain",
        "assistance_policy_default",
        "preserve_all_attempts",
        "reject_out_of_turn",
        "reject_wrong_seat"
      ],
      "type": "object"
    },
    "profile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "version"
      ],
      "type": "object"
    },
    "reconnect": {
      "additionalProperties": false,
      "properties": {
        "preserve_seat": {
          "type": "boolean"
        },
        "rotate_token_on_claim": {
          "type": "boolean"
        },
        "token_bytes": {
          "type": "integer"
        }
      },
      "required": [
        "preserve_seat",
        "rotate_token_on_claim",
        "token_bytes"
      ],
      "type": "object"
    },
    "referee": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hidden_information_scope": {
          "type": "string"
        },
        "may_enforce_deadline": {
          "type": "boolean"
        },
        "may_pause": {
          "type": "boolean"
        },
        "may_resume": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "hidden_information_scope",
        "may_enforce_deadline",
        "may_pause",
        "may_resume"
      ],
      "type": "object"
    },
    "room": {
      "additionalProperties": false,
      "properties": {
        "allow_spectators": {
          "type": "boolean"
        },
        "default_turn_seconds": {
          "type": "integer"
        },
        "maximum_turn_seconds": {
          "type": "integer"
        },
        "minimum_turn_seconds": {
          "type": "integer"
        },
        "reconnect_grace_seconds": {
          "type": "integer"
        },
        "require_all_ready": {
          "type": "boolean"
        },
        "seats": {
          "type": "integer"
        },
        "server_authoritative": {
          "type": "boolean"
        }
      },
      "required": [
        "allow_spectators",
        "default_turn_seconds",
        "maximum_turn_seconds",
        "minimum_turn_seconds",
        "reconnect_grace_seconds",
        "require_all_ready",
        "seats",
        "server_authoritative"
      ],
      "type": "object"
    },
    "scaling": {
      "additionalProperties": false,
      "properties": {
        "event_poll_interval_ms": {
          "type": "integer"
        },
        "multi_node_pubsub_adapter": {
          "type": "string"
        },
        "store": {
          "type": "string"
        }
      },
      "required": [
        "event_poll_interval_ms",
        "multi_node_pubsub_adapter",
        "store"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "timeout": {
      "additionalProperties": false,
      "properties": {
        "allow_bot_takeover": {
          "type": "boolean"
        },
        "default_action": {
          "type": "string"
        },
        "record_adjudication_event": {
          "type": "boolean"
        }
      },
      "required": [
        "allow_bot_takeover",
        "default_action",
        "record_adjudication_event"
      ],
      "type": "object"
    }
  },
  "required": [
    "anti_cheat",
    "profile",
    "reconnect",
    "referee",
    "room",
    "scaling",
    "schema_version",
    "timeout"
  ],
  "type": "object"
}
