{
  "$id": "https://baloot.local/schemas/contracts/commit-identities-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "identities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "email", "use", "reason"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9 ._+\\[\\]-]*[A-Za-z0-9\\]])?$(?![\\s\\S])" },
          "email": { "type": "string" },
          "use": { "enum": ["all", "Signed-off-by"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" }
        },
        "oneOf": [
          {
            "properties": {
              "email": {
                "pattern": "^(?:[a-zA-Z0-9._+\\[\\]-]+@users\\.noreply\\.github\\.com|no-?reply@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)+)$(?![\\s\\S])"
              }
            }
          },
          {
            "title": "Dependabot sign-off exception",
            "properties": {
              "name": { "const": "dependabot[bot]" },
              "email": { "const": "support@github.com" },
              "use": { "const": "Signed-off-by" }
            }
          }
        ]
      }
    }
  }
}
